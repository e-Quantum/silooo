{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silooo.com/schemas/usines.schema.json",
  "title": "Usines de Silooo",
  "description": "Forme de definitions/usines.json. Les chiffres vivent dans le fichier de données, pas ici : le schéma ne fixe que les types et les bornes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "unites", "usines"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "source": { "type": "string", "minLength": 1 },
    "unites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prixNiveau1", "productionParNiveau"],
      "properties": {
        "prixNiveau1": { "type": "string", "minLength": 1 },
        "productionParNiveau": { "type": "string", "minLength": 1 }
      }
    },
    "usines": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/usine" }
    }
  },
  "$defs": {
    "identifiant": {
      "description": "Identifiant en kebab-case : minuscules sans accent, chiffres, tirets.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "usine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "nom", "epoque", "produit", "entrees",
        "decouverte", "prixNiveau1", "productionParNiveau", "electricite"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifiant" },
        "nom": { "type": "string", "minLength": 1 },
        "epoque": { "type": "integer", "minimum": 1 },
        "produit": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifiant" }
        },
        "entrees": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifiant" }
        },
        "decouverte": {
          "description": "Comment l'usine se débloque : au départ, à un niveau d'entreprise, à une époque, ou après une autre usine.",
          "type": "string",
          "pattern": "^(depart|niveau-entreprise-[0-9]+|epoque-[0-9]+|apres-[a-z0-9]+(-[a-z0-9]+)*)$"
        },
        "prixNiveau1": { "type": "number", "exclusiveMinimum": 0 },
        "productionParNiveau": { "type": "number", "exclusiveMinimum": 0 },
        "electricite": { "type": "boolean" }
      }
    }
  }
}
