{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silooo.com/schemas/iles.schema.json",
  "title": "Îles de Silooo",
  "description": "Forme de definitions/iles.json : où l'add-on pose les mini-îles des usines autour de l'île principale, et de quoi elles sont faites. Les chiffres vivent dans le fichier de données, pas ici : le schéma ne fixe que les types et les bornes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "commentaire",
    "hauteur",
    "centreDansLaCase",
    "anneau",
    "plateforme",
    "apparition",
    "ruine",
    "materiaux",
    "usines",
    "cinematique",
    "atelier"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "commentaire": {
      "type": "string"
    },
    "hauteur": {
      "description": "Altitude (y) de la face du dessus des plateformes, en blocs. Les joueurs se tiennent un bloc au-dessus.",
      "type": "integer",
      "minimum": -60,
      "maximum": 300
    },
    "centreDansLaCase": {
      "description": "Décalage en blocs du centre de l'île principale par rapport à l'origine de la case (CompanyState.island), qui est le coin de la case au plus petit x et au plus petit z. Une case fait ecartEntreCases de côté (monde.json) : le centre en est le milieu.",
      "$ref": "#/$defs/point"
    },
    "anneau": {
      "description": "Où se tiennent les mini-îles : sur un carré autour du centre de l'île principale, qui fait 512 × 512 blocs une fois débloquée.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ilePrincipaleDemiCote",
        "demiCote"
      ],
      "properties": {
        "ilePrincipaleDemiCote": {
          "description": "Demi-côté en blocs de l'île principale une fois débloquée (512 × 512, donc 256), autour du même centre : les mini-îles doivent rester en dehors.",
          "type": "integer",
          "minimum": 1
        },
        "demiCote": {
          "description": "Distance en blocs du centre au carré sur lequel se tiennent les centres des mini-îles, mesurée le long de x ou de z : au moins 256 pour rester hors de l'île principale, au plus la moitié de la case moins le rayon d'une plateforme.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "plateforme": {
      "description": "Le sol d'une mini-île : un disque, en couches de plus en plus étroites vers le bas.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rayon",
        "couches"
      ],
      "properties": {
        "rayon": {
          "description": "Rayon en blocs de la couche du dessus.",
          "type": "integer",
          "minimum": 3
        },
        "couches": {
          "description": "De haut en bas. La première couche est la face du dessus, à l'altitude « hauteur ».",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "materiau",
              "retrait"
            ],
            "properties": {
              "materiau": {
                "type": "string",
                "enum": [
                  "herbe",
                  "terre",
                  "pierre"
                ]
              },
              "retrait": {
                "description": "Blocs de rayon en moins que la couche du dessus.",
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "apparition": {
      "description": "Le point où le joueur apparaît, sur la mini-île de départ.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usine",
        "distance",
        "oooscar"
      ],
      "properties": {
        "usine": {
          "description": "L'usine dont le joueur apparaît sur l'île : sa Carrière.",
          "$ref": "#/$defs/identifiant"
        },
        "distance": {
          "description": "Distance en blocs du centre de la mini-île, du côté de l'île principale, hors du bâtiment.",
          "type": "integer",
          "minimum": 1
        },
        "oooscar": {
          "description": "Où se tient Oooscar à l'arrivée, par rapport au centre de la mini-île de départ.",
          "$ref": "#/$defs/decalagePlat"
        }
      }
    },
    "ruine": {
      "description": "Ce qui se voit d'une usine en ruine.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partMursAbimesPourcent",
        "partSolAbimePourcent"
      ],
      "properties": {
        "partMursAbimesPourcent": {
          "description": "Part des blocs de mur qui manquent ou sont remplacés par des gravats.",
          "$ref": "#/$defs/pourcentage"
        },
        "partSolAbimePourcent": {
          "description": "Part de la face du dessus où l'herbe est arrachée.",
          "$ref": "#/$defs/pourcentage"
        }
      }
    },
    "materiaux": {
      "description": "Les blocs de Minecraft qui jouent la palette de design/decor/ (herbe, terre, pierre, planches) et les détails.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "herbe",
        "terre",
        "pierre",
        "planches",
        "toit",
        "gravats",
        "mousse",
        "echafaudage",
        "lumiere",
        "enseigne",
        "vide"
      ],
      "properties": {
        "herbe": {
          "$ref": "#/$defs/bloc"
        },
        "terre": {
          "$ref": "#/$defs/bloc"
        },
        "pierre": {
          "$ref": "#/$defs/bloc"
        },
        "planches": {
          "$ref": "#/$defs/bloc"
        },
        "toit": {
          "description": "Le toit d'une usine active.",
          "$ref": "#/$defs/bloc"
        },
        "gravats": {
          "description": "Ce qui reste d'un mur de pierre abîmé.",
          "$ref": "#/$defs/bloc"
        },
        "mousse": {
          "description": "Ce qui reste d'un mur de planches abîmé, et le sol arraché.",
          "$ref": "#/$defs/bloc"
        },
        "echafaudage": {
          "description": "Les poteaux d'un chantier (usine en remise en état).",
          "$ref": "#/$defs/bloc"
        },
        "lumiere": {
          "description": "La lanterne d'une usine active.",
          "$ref": "#/$defs/bloc"
        },
        "enseigne": {
          "description": "L'enseigne murale qui porte le nom de l'usine, au-dessus de sa porte.",
          "$ref": "#/$defs/bloc"
        },
        "vide": {
          "$ref": "#/$defs/bloc"
        }
      }
    },
    "usines": {
      "description": "Un emplacement et un bâtiment par usine du catalogue (usines.json). Le bâtiment dépend de l'identifiant d'usine.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "angle",
          "murs",
          "largeur",
          "profondeur",
          "hauteur"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifiant"
          },
          "angle": {
            "description": "Direction du centre de l'île principale vers cette mini-île, en degrés : 0 vers l'est (x croissant), 90 vers le sud (z croissant), donc dans le sens des aiguilles d'une montre vu d'en haut.",
            "type": "integer",
            "minimum": 0,
            "maximum": 359
          },
          "murs": {
            "type": "string",
            "enum": [
              "planches",
              "pierre"
            ]
          },
          "largeur": {
            "description": "Taille du bâtiment le long de x, en blocs, impaire pour que la porte tombe au milieu.",
            "type": "integer",
            "minimum": 3,
            "maximum": 11
          },
          "profondeur": {
            "description": "Taille du bâtiment le long de z, en blocs, impaire.",
            "type": "integer",
            "minimum": 3,
            "maximum": 11
          },
          "hauteur": {
            "description": "Hauteur des murs en blocs, au moins 3 pour la porte et l'enseigne.",
            "type": "integer",
            "minimum": 3,
            "maximum": 16
          },
          "rayon": {
            "description": "Rayon propre à cette île ; absent, celui de la plateforme.",
            "type": "integer",
            "minimum": 3,
            "maximum": 19
          },
          "apparition": {
            "description": "Distance du point d’arrivée de cette usine ; absent, celle de l’apparition générale.",
            "type": "integer",
            "minimum": 1,
            "maximum": 18
          }
        }
      }
    },
    "cinematique": {
      "description": "La cinématique d'arrivée (design/composants/Cinematique.md : 20 secondes, 4 plans), filmée autour de la mini-île de départ. Chaque plan part d'un point, glisse vers un autre et regarde un point fixe ; tous les points sont donnés par rapport au centre de cette mini-île.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plans"
      ],
      "properties": {
        "plans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "duree",
              "depart",
              "arrivee",
              "regard"
            ],
            "properties": {
              "duree": {
                "description": "Durée du plan en secondes.",
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 20
              },
              "depart": {
                "description": "Où la caméra commence.",
                "$ref": "#/$defs/vue"
              },
              "arrivee": {
                "description": "Où la caméra finit.",
                "$ref": "#/$defs/vue"
              },
              "regard": {
                "description": "Le point que la caméra regarde pendant tout le plan.",
                "$ref": "#/$defs/vue"
              }
            }
          }
        }
      }
    },
    "atelier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "introductionRevision",
        "volumes",
        "machines",
        "salarie",
        "enseigne",
        "structure",
        "hauteurNettoyage",
        "transport",
        "structureRuine",
        "solStructure",
        "machinerie",
        "ambiance"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "introductionRevision": {
          "type": "integer",
          "minimum": 1
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "de",
              "a",
              "bloc"
            ],
            "properties": {
              "de": {
                "$ref": "#/$defs/vue"
              },
              "a": {
                "$ref": "#/$defs/vue"
              },
              "bloc": {
                "$ref": "#/$defs/blocAtelier"
              }
            }
          }
        },
        "machines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "position",
              "bloc"
            ],
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "broyeur",
                  "convoyeur",
                  "stock",
                  "bureau"
                ]
              },
              "position": {
                "$ref": "#/$defs/vue"
              },
              "bloc": {
                "$ref": "#/$defs/blocAtelier"
              }
            }
          }
        },
        "salarie": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "position",
            "regard"
          ],
          "properties": {
            "position": {
              "$ref": "#/$defs/vue"
            },
            "regard": {
              "$ref": "#/$defs/vue"
            }
          }
        },
        "enseigne": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "position",
            "support"
          ],
          "properties": {
            "position": {
              "$ref": "#/$defs/vue"
            },
            "support": {
              "$ref": "#/$defs/vue"
            }
          }
        },
        "structure": {
          "type": "string",
          "pattern": "^silooo:[a-z0-9_]+$",
          "description": "La structure du pack posée quand la Carrière est active (tools/carriere/structure.py)."
        },
        "hauteurNettoyage": {
          "type": "integer",
          "minimum": 9,
          "maximum": 30
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "longueur",
            "vitesse",
            "pierres",
            "hauteur"
          ],
          "properties": {
            "longueur": {
              "type": "number",
              "minimum": 1,
              "maximum": 30
            },
            "vitesse": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 4
            },
            "pierres": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "hauteur": {
              "description": "Hauteur du dessous des pierres au-dessus du bas du bloc du convoyeur, en blocs : le dessus de la toile.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "structureRuine": {
          "description": "La structure posée quand la Carrière n'est pas active : en ruine ou en travaux.",
          "type": "string",
          "pattern": "^silooo:[a-z0-9_]+$"
        },
        "solStructure": {
          "description": "Hauteur de la face du dessus de la plateforme dans la structure, en blocs depuis son bas : la structure est posée à hauteur - solStructure.",
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "machinerie": {
          "description": "Les machines animées par le pack (ailes, pilons), posées comme le salarié quand la Carrière est active. lacet : orientation en degrés, 0 vers le sud, 90 vers l'ouest.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entite",
              "position",
              "lacet"
            ],
            "properties": {
              "entite": {
                "type": "string",
                "pattern": "^silooo:[a-z0-9_]+$"
              },
              "position": {
                "$ref": "#/$defs/vue"
              },
              "lacet": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            }
          }
        },
        "ambiance": {
          "description": "Sons et particules joués en boucle quand la Carrière tourne (docs/carriere.md) : toutes les « periode » secondes, au point donné.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "effet",
              "id",
              "position",
              "periode"
            ],
            "properties": {
              "effet": {
                "type": "string",
                "enum": [
                  "son",
                  "particule"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^silooo[.:][a-z0-9_.]+$"
              },
              "position": {
                "$ref": "#/$defs/vue"
              },
              "periode": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 60
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "decalagePlat": {
      "description": "Un décalage sur le sol de la mini-île, dans son repère : « avant » va vers le centre de l'île principale, « droite » est à droite quand on regarde vers l'avant. En blocs.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avant",
        "droite"
      ],
      "properties": {
        "avant": {
          "type": "number",
          "minimum": -200,
          "maximum": 200
        },
        "droite": {
          "type": "number",
          "minimum": -200,
          "maximum": 200
        }
      }
    },
    "vue": {
      "description": "Un point de la mise en scène, dans le repère de la mini-île : avant, droite (voir decalagePlat) et haut, au-dessus de la face du dessus de la plateforme. En blocs.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avant",
        "droite",
        "haut"
      ],
      "properties": {
        "avant": {
          "type": "number",
          "minimum": -200,
          "maximum": 200
        },
        "droite": {
          "type": "number",
          "minimum": -200,
          "maximum": 200
        },
        "haut": {
          "type": "number",
          "minimum": -50,
          "maximum": 200
        }
      }
    },
    "identifiant": {
      "description": "Identifiant en kebab-case : minuscules sans accent, chiffres, tirets.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "bloc": {
      "description": "Identifiant d'un type de bloc de Minecraft.",
      "type": "string",
      "pattern": "^minecraft:[a-z0-9_]+$"
    },
    "pourcentage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "z"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "z": {
          "type": "integer"
        }
      }
    },
    "blocAtelier": {
      "description": "Bloc du décor, vanilla ou personnalisé Silooo.",
      "type": "string",
      "pattern": "^(minecraft|silooo):[a-z0-9_]+$"
    }
  }
}
