{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silooo.com/schemas/economie.schema.json",
  "title": "Économie de Silooo",
  "description": "Forme de definitions/economie.json. Les chiffres vivent dans le fichier de données, pas ici : le schéma ne fixe que les types et les bornes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "niveaux", "horsLigne", "prestige", "lingotsHorsPrestige", "commandeDuJour", "ville", "notation"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "niveaux": {
      "type": "object",
      "additionalProperties": false,
      "required": ["croissancePrix", "formulePrix", "paliersX2", "retourMaxSeuleUsineHeures"],
      "properties": {
        "croissancePrix": { "type": "number", "exclusiveMinimum": 1 },
        "retourMaxSeuleUsineHeures": { "type": "number", "exclusiveMinimum": 0, "description": "Garde-fou d'équilibrage, que le jeu ne lit pas : tant que l'usine de départ est seule, chacun de ses niveaux se rembourse en ce nombre d'heures au plus. Un test du service le vérifie." },
        "formulePrix": { "type": "string", "minLength": 1 },
        "paliersX2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixes", "ensuiteTous", "commentaire"],
          "properties": {
            "fixes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1 }
            },
            "ensuiteTous": { "type": "integer", "minimum": 1 },
            "commentaire": { "type": "string" }
          }
        }
      }
    },
    "horsLigne": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plafondHeures", "efficacite"],
      "properties": {
        "plafondHeures": { "type": "number", "exclusiveMinimum": 0 },
        "efficacite": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "prestige": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seuils", "etoilesSuivantes", "facteurSeuilSuivant", "conversionLingots",
        "productionParEtoile", "bonusParLingotDetenu", "departDeCourse"
      ],
      "properties": {
        "seuils": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["course", "fin", "donar"],
            "properties": {
              "course": { "type": "integer", "minimum": 1 },
              "fin": { "type": "string", "minLength": 1 },
              "donar": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "etoilesSuivantes": { "type": "string" },
        "facteurSeuilSuivant": {
          "description": "Au-delà de la dernière course listée dans seuils, chaque seuil vaut le précédent multiplié par ce facteur (la lecture chiffrée de etoilesSuivantes).",
          "type": "number",
          "exclusiveMinimum": 1
        },
        "conversionLingots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coefficient", "diviseurReference", "formule"],
          "properties": {
            "coefficient": { "type": "number", "exclusiveMinimum": 0 },
            "diviseurReference": { "type": "number", "exclusiveMinimum": 0 },
            "formule": { "type": "string", "minLength": 1 }
          }
        },
        "productionParEtoile": { "type": "number", "exclusiveMinimum": 0 },
        "bonusParLingotDetenu": { "type": "number", "minimum": 0 },
        "departDeCourse": {
          "description": "L'usine qui est déjà là au début de chaque course, et son niveau ; les autres usines repartent à zéro.",
          "type": "object",
          "additionalProperties": false,
          "required": ["usine", "niveau"],
          "properties": {
            "usine": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
            "niveau": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "lingotsHorsPrestige": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missionBienvenue", "missionSuivante", "moyenneParHeureDeJeu", "commandeDuJour", "trouvaille"],
      "properties": {
        "missionBienvenue": { "type": "integer", "minimum": 0 },
        "missionSuivante": { "type": "integer", "minimum": 0 },
        "moyenneParHeureDeJeu": { "type": "number", "minimum": 0 },
        "commandeDuJour": { "type": "integer", "minimum": 0 },
        "trouvaille": { "type": "integer", "minimum": 0 }
      }
    },
    "commandeDuJour": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectifUnites", "minutesDeProductionParUnite"],
      "properties": {
        "objectifUnites": { "type": "integer", "minimum": 1 },
        "minutesDeProductionParUnite": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "ville": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zonesPrixLingots"],
      "properties": {
        "zonesPrixLingots": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "notation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apresMd", "limiteDouble"],
      "properties": {
        "apresMd": { "type": "string" },
        "limiteDouble": { "type": "string" }
      }
    }
  }
}
