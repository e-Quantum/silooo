{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silooo.com/schemas/boutique.schema.json",
  "title": "Boutique de Silooo",
  "description": "Forme de definitions/boutique.json. Les prix vivent dans le fichier de données, pas ici : le schéma ne fixe que les types et les bornes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "commentaire", "packsGemmes", "grades", "regleGrades", "abonnements"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "commentaire": { "type": "string" },
    "packsGemmes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gemmes", "euros", "bonusPourcent"],
        "properties": {
          "gemmes": { "type": "integer", "minimum": 1 },
          "euros": { "$ref": "#/$defs/euros" },
          "bonusPourcent": { "$ref": "#/$defs/pourcentage" }
        }
      }
    },
    "grades": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nom", "gemmes", "bonusDonarPourcent"],
        "properties": {
          "id": { "$ref": "#/$defs/identifiantGrade" },
          "nom": { "type": "string", "minLength": 1 },
          "gemmes": { "type": "integer", "minimum": 1 },
          "bonusDonarPourcent": { "$ref": "#/$defs/pourcentage" }
        }
      }
    },
    "regleGrades": { "type": "string" },
    "abonnements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "Un abonnement porte soit un bonus de Donar (avec les Gemmes rendues), soit une réserve à un grade.",
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "gemmes", "jours"],
        "properties": {
          "id": { "$ref": "#/$defs/identifiant" },
          "gemmes": { "type": "integer", "minimum": 1 },
          "jours": { "type": "integer", "minimum": 1 },
          "bonusDonarPourcent": { "$ref": "#/$defs/pourcentage" },
          "gemmesRendues": { "type": "integer", "minimum": 0 },
          "reserveA": { "$ref": "#/$defs/identifiantGrade" }
        },
        "dependentRequired": {
          "bonusDonarPourcent": ["gemmesRendues"],
          "gemmesRendues": ["bonusDonarPourcent"]
        },
        "anyOf": [
          { "required": ["bonusDonarPourcent"] },
          { "required": ["reserveA"] }
        ]
      }
    }
  },
  "$defs": {
    "identifiant": {
      "description": "Identifiant en kebab-case : minuscules sans accent, chiffres, tirets.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "identifiantGrade": {
      "description": "Identifiant de grade : kebab-case, avec un « + » final permis pour les grades calqués sur SileneMC (vip+).",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\+?$"
    },
    "euros": {
      "description": "Prix en euros, virgule décimale et deux décimales : « 0,99 ».",
      "type": "string",
      "pattern": "^[0-9]+,[0-9]{2}$"
    },
    "pourcentage": { "type": "integer", "minimum": 0, "maximum": 100 }
  }
}
