{
  "namespace": "server_form",
  "main_screen_content": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "size": [
            "100%",
            "100%"
          ],
          "control_ids": {
            "long_form": "@server_form.long_form",
            "custom_form": "@server_form.custom_form"
          }
        }
      }
    ]
  },
  "long_form": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [
            "100% - 15px",
            10
          ],
          "$title_max_size": [
            "100% - 15px",
            10
          ],
          "size": [
            225,
            200
          ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.long_form_panel",
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - '§s§d§i§s') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "silooo_discord@server_form.silooo_discord": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§s§d§i§s') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "silooo_discord": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "layer": 2,
    "controls": [
      {
        "voile": {
          "type": "image",
          "texture": "textures/ui/silooo_discord/noir",
          "size": [
            "100%",
            "100%"
          ],
          "alpha": 0.65,
          "layer": 0
        }
      },
      {
        "fenetre@server_form.silooo_discord_fenetre": {}
      }
    ]
  },
  "silooo_discord_fenetre": {
    "type": "panel",
    "size": [
      "166%y",
      "86%"
    ],
    "max_size": [
      "94%",
      "86%"
    ],
    "layer": 1,
    "controls": [
      {
        "fond": {
          "type": "image",
          "texture": "textures/ui/silooo_discord/panneau",
          "size": [
            "100%",
            "100%"
          ],
          "layer": 0
        }
      },
      {
        "calques@server_form.silooo_discord_calques": {}
      },
      {
        "texte@server_form.silooo_discord_texte": {}
      },
      {
        "fermer@common.close_button": {
          "$close_button_offset": [
            -4,
            4
          ],
          "layer": 20
        }
      }
    ]
  },
  "silooo_discord_calques": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [
      "100%",
      "100%"
    ],
    "layer": 2,
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "@server_form.silooo_discord_calque",
        "label": "@server_form.silooo_discord_rien",
        "header": "@server_form.silooo_discord_rien",
        "divider": "@server_form.silooo_discord_rien"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "silooo_discord_rien": {
    "type": "panel",
    "size": [
      0,
      0
    ]
  },
  "silooo_discord_calque": {
    "type": "panel",
    "size": [
      0,
      "100%"
    ],
    "controls": [
      {
        "dessus": {
          "type": "panel",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [
            "166%y",
            "100%"
          ],
          "controls": [
            {
              "banniere@server_form.silooo_discord_zone_banniere": {}
            },
            {
              "carte@server_form.silooo_discord_zone_qr": {}
            },
            {
              "continuer@server_form.silooo_discord_zone_bouton": {}
            }
          ]
        }
      }
    ]
  },
  "silooo_discord_zone": {
    "type": "panel"
  },
  "silooo_discord_image": {
    "type": "image",
    "size": [
      "100%",
      "100%"
    ],
    "keep_ratio": false,
    "fill": true,
    "bindings": [
      {
        "binding_name": "#form_button_texture",
        "binding_name_override": "#texture",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_texture_file_system",
        "binding_name_override": "#texture_file_system",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
        "target_property_name": "#visible"
      }
    ]
  },
  "silooo_discord_texte_bouton": {
    "type": "label",
    "text": "#form_button_text",
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      }
    ]
  },
  "silooo_discord_zone_banniere@server_form.silooo_discord_zone": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#form_button_text - '§1§1') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [
      1,
      1
    ],
    "size": [
      "100% - 2px",
      "41.5%"
    ],
    "layer": 2,
    "controls": [
      {
        "image@server_form.silooo_discord_image": {
          "layer": 1
        }
      },
      {
        "badge": {
          "type": "image",
          "texture": "textures/ui/silooo_discord/badge",
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "offset": [
            "3%",
            -6
          ],
          "size": [
            "100%c + 8px",
            "100%c + 4px"
          ],
          "layer": 2,
          "controls": [
            {
              "texte@server_form.silooo_discord_texte_bouton": {
                "size": [
                  "default",
                  "default"
                ],
                "color": [
                  1,
                  0.9647,
                  0.8706
                ],
                "layer": 1
              }
            }
          ]
        }
      }
    ]
  },
  "silooo_discord_zone_qr@server_form.silooo_discord_zone": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#form_button_text - '§2§2') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [
      "-3%",
      "28%"
    ],
    "size": [
      "27%",
      "64%"
    ],
    "layer": 3,
    "controls": [
      {
        "carte": {
          "type": "image",
          "texture": "textures/ui/silooo_discord/carte",
          "size": [
            "100%",
            "100%"
          ],
          "layer": 1
        }
      },
      {
        "qr@server_form.silooo_discord_image": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [
            0,
            4
          ],
          "size": [
            "100% - 8px",
            "100% - 34px"
          ],
          "keep_ratio": true,
          "fill": false,
          "layer": 2
        }
      },
      {
        "legende@server_form.silooo_discord_texte_bouton": {
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [
            0,
            -4
          ],
          "size": [
            "100% - 8px",
            "default"
          ],
          "text_alignment": "center",
          "color": [
            0.1176,
            0.1098,
            0.102
          ],
          "layer": 2
        }
      }
    ]
  },
  "silooo_discord_zone_bouton@server_form.silooo_discord_zone": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#form_button_text - '§3§3') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ],
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "offset": [
      "4%",
      "-5%"
    ],
    "size": [
      "42%",
      24
    ],
    "layer": 3,
    "controls": [
      {
        "bouton@common_buttons.light_text_button": {
          "size": [
            "100%",
            "100%"
          ],
          "$pressed_button_name": "button.form_button_click",
          "$button_text": "",
          "$button_text_binding_type": "none",
          "$default_button_texture": "textures/ui/silooo_discord/bouton",
          "$hover_button_texture": "textures/ui/silooo_discord/bouton",
          "$pressed_button_texture": "textures/ui/silooo_discord/bouton_appui",
          "$default_text_color": [
            1,
            1,
            1
          ],
          "$hover_text_color": [
            1,
            1,
            1
          ],
          "default_focus_precedence": 10,
          "layer": 1,
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      },
      {
        "texte@server_form.silooo_discord_texte_bouton": {
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [
            0,
            -1
          ],
          "size": [
            "default",
            "default"
          ],
          "font_type": "MinecraftTen",
          "font_scale_factor": 1.3,
          "shadow": true,
          "color": [
            1,
            1,
            1
          ],
          "layer": 10
        }
      }
    ]
  },
  "silooo_discord_texte": {
    "type": "stack_panel",
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [
      "4%",
      "46%"
    ],
    "size": [
      "58%",
      "36%"
    ],
    "layer": 2,
    "controls": [
      {
        "titre": {
          "type": "label",
          "size": [
            "100%",
            "default"
          ],
          "font_type": "MinecraftTen",
          "font_scale_factor": 2.0,
          "shadow": true,
          "color": [
            1,
            1,
            1
          ],
          "text": "#text",
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - '§s§d§i§s§r')",
              "target_property_name": "#text"
            }
          ]
        }
      },
      {
        "espace_corps": {
          "type": "panel",
          "size": [
            "100%",
            4
          ]
        }
      },
      {
        "corps": {
          "type": "label",
          "size": [
            "100%",
            "default"
          ],
          "color": [
            1,
            1,
            1
          ],
          "shadow": true,
          "text": "#form_text"
        }
      }
    ]
  }
}
