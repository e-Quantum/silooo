{
  "name": "silooo-addon",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "description": "Pack de comportement de Silooo : le code TypeScript que BDS charge. Il affiche, silooo-core décide.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node scripts/tester.mjs",
    "build": "npm run check && node scripts/construire.mjs"
  },
  "devDependencies": {
    "@minecraft/server": "2.11.0",
    "@minecraft/server-admin": "1.0.0-beta.1.26.62-stable",
    "@minecraft/server-net": "1.0.0-beta.1.26.62-stable",
    "@minecraft/server-ui": "2.3.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "typescript": "6.0.3"
  }
}
