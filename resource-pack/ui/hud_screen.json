      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#hud_title_text_string = 'silooo:cinema|') or (('silooo:consigne|' + (#text - 'silooo:consigne|')) = #text) or (('silooo:parole|' + (#text - 'silooo:parole|')) = #text)))",
        "target_property_name": "#visible"
