      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((('silooo:hud|' + (#text - 'silooo:hud|')) = #text) or (#text = 'silooo:cinema|')))",
        "target_property_name": "#visible"
      }
    ]
  },
  "hud_title_text/subtitle_frame/subtitle": {
